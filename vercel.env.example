# ============================================================
# Variables para Vercel (Production)
# Copia estos nombres y valores en:
#   Vercel → Tu proyecto → Settings → Environment Variables
# Backend: https://dnsh-evaluator-production.up.railway.app
# ============================================================

VITE_USE_API=true
VITE_API_URL=https://dnsh-evaluator-production.up.railway.app/api/v1
# Socket.IO para usuarios en línea, notificaciones y colaboración en tiempo real
VITE_SOCKET_URL=https://dnsh-evaluator-production.up.railway.app

# Google Login (obligatorio para el botón "Continuar con Google"):
# VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GEMINI_API_KEY=
