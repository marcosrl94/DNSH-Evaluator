# ===========================================
# Backend - DNSH Evaluator API
# Copia a .env y rellena con tus valores
# ===========================================

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL (obligatorio)
# Railway: usa Variable Reference desde el plugin Postgres (DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres_dev@localhost:5432/ecoinvest_dnsh_evaluator
# Opcional: tamaño del pool (default 10; Railway recomienda 5-10)
# DATABASE_POOL_SIZE=10
# Alternativa por variables sueltas:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=ecoinvest_dnsh_evaluator
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres_dev

# JWT (obligatorio; en producción usa un secreto fuerte)
JWT_SECRET=cambiar-por-secreto-seguro-en-produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# CORS: orígenes del frontend separados por coma
# Producción: incluir https://dnsh-evaluator.vercel.app
CORS_ORIGIN=https://dnsh-evaluator.vercel.app,http://localhost:5173,http://localhost:3000

# Google OAuth (opcional)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# ALLOWED_DOMAINS=tuempresa.com

# AWS S3 - evidencias (opcional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Stripe - suscripciones (opcional)
# STRIPE_CHECKOUT_URL=

# Logs
LOG_LEVEL=info
