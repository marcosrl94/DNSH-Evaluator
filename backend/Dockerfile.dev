# ============================================
# DNSH Evaluator Backend - Dockerfile DEV
# Para desarrollo con hot-reload
# ============================================

FROM node:20-alpine

WORKDIR /app

# Instalar dependencias (incluyendo dev)
COPY package*.json ./
RUN npm install

# Exponer puerto
EXPOSE 3001

# Comando con hot-reload
CMD ["npm", "run", "dev"]
