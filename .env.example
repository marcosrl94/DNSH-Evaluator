# ===========================================
# Frontend - DNSH Evaluator
# Copia a .env o .env.local y ajusta valores
# Producción: configurar en Vercel → Settings → Environment Variables
# App en producción: https://dnsh-evaluator.vercel.app/
# ===========================================

# Activar API (datos y auth contra el backend)
VITE_USE_API=true

# URL del backend (incluir /api/v1)
# Local:       http://localhost:3001/api/v1
# Producción:  https://dnsh-evaluator-production.up.railway.app/api/v1
VITE_API_URL=http://localhost:3001/api/v1

# Socket.IO (usuarios online, colaboración)
# Producción:  https://dnsh-evaluator-production.up.railway.app
VITE_SOCKET_URL=http://localhost:3001

# Google Sign-In (opcional). En producción añade en Google Cloud:
# Authorized JavaScript origins: https://dnsh-evaluator.vercel.app
# VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Gemini / IA (opcional)
# GEMINI_API_KEY=
